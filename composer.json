{
    "name": "phasync/net",
    "description": "TCP, UDP and Unix socket networking for PHP using phasync coroutines.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "phasync\\Net\\": "src/Net/"
        },
        "files": [
            "src/Net/functions.php"
        ]
    },
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
